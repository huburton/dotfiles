#!/bin/bash
# ecran-principal : fait de l'OLED AOC 27" (en bas à gauche) l'écran principal de la session
# (demande de Hugo, 25/10/2026). Lancé une fois par session par ~/.local/bin/session-daemons.
#   - XWayland : l'écran « primary » (jeux, Steam, Wine/Fusion s'y ouvrent en plein écran) ;
#   - Hyprland : la session démarre avec le focus et la souris sur cet écran.
# La barre complète d'ii suit bar.mainMonitor dans ~/.config/illogical-impulse/config.json.
#   ecran-principal               les deux
#   ecran-principal --sans-focus  seulement XWayland (ne déplace pas la souris)
# Retour arrière : session-daemons.bak-2026-10-25-ecran et config.json.bak-2026-10-25-ecran.
MODELE="Q27G4SDR"
NOM=""
for _ in $(seq 1 20); do
    NOM=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$MODELE" '.[] | select(.description | contains($m)) | .name')
    [ -n "$NOM" ] && break
    sleep 1
done
[ -n "$NOM" ] || { echo "[ecran-principal] $(date -Iseconds) écran $MODELE introuvable" >&2; exit 1; }
[ -n "$DISPLAY" ] && xrandr --output "$NOM" --primary 2>/dev/null
[ "$1" = "--sans-focus" ] || hyprctl dispatch "hl.dsp.focus({ monitor = \"$NOM\" })" >/dev/null
echo "[ecran-principal] $(date -Iseconds) $NOM"
