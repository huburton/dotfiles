#!/usr/bin/env python3
"""pc-status — état et pilotage de l'IA d'une machine, pour la plateforme (page IA.) et job-scout.

Tourne sur le PC (archfixe, service utilisateur pc-status) et sur le serveur (lien ~/.local/bin/ai-status,
service ai-status). HTTP sur 0.0.0.0:8097, protégé par la clé du routeur llama.cpp local (en Bearer).
  GET  /status                → mode IA, présence de Hugo, GPU, modèles du routeur, services
  POST /ai-mode   {"on": bool}                (PC seulement : ai-mode)
  POST /llm/load  {"model": "qwen3.5-9b"}     POST /llm/unload {"model": "..."}
Réglages (variables d'environnement) : AI_STATUS_ROUTER, AI_STATUS_KEY_FILE, AI_STATUS_PORT,
AI_STATUS_SERVICES (« nom:user » ou « nom:system », séparés par des virgules).
"""
import glob
import json
import os
import subprocess
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
KEY = Path(os.environ.get("AI_STATUS_KEY_FILE", HOME / ".config/llm/api-key")).read_text().strip()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
ROUTER = os.environ.get("AI_STATUS_ROUTER", "http://127.0.0.1:8080")
PORT = int(os.environ.get("AI_STATUS_PORT", "8097"))
SERVICES = [s.split(":") for s in os.environ.get("AI_STATUS_SERVICES", "llama-router:user,jarvis:user").split(",") if s]
AI_MODE = HOME / ".local/bin/ai-mode"  # absent sur le serveur
OLED = HOME / ".local/bin/oled-screensaver"
AUTO_FLAG = RUNTIME / "ai-mode.auto"  # mode IA activé par pc-status (Hugo absent) : désactivé à son retour
AUTO_AFTER_S = int(os.environ.get("AI_STATUS_AUTO_AFTER", "600"))


def _env() -> dict:
    env = dict(os.environ)
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):  # service lancé hors de la session graphique
        sigs = sorted(glob.glob(str(RUNTIME / "hypr" / "*")), key=os.path.getmtime)
        if sigs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(sigs[-1])
    env.setdefault("WAYLAND_DISPLAY", "wayland-1")
    return env


def _router(path: str, body: dict | None = None):
    req = urllib.request.Request(ROUTER + path, headers={"Authorization": f"Bearer {KEY}", "Content-Type": "application/json"},
                                 data=json.dumps(body).encode() if body is not None else None,
                                 method="POST" if body is not None else "GET")
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read() or b"{}")


def _idle() -> bool:
    pids = RUNTIME / "oled-screensaver.pids"  # économiseur actif = Hugo absent depuis ≥ 2 min
    return pids.exists() and pids.stat().st_size > 0


def auto_ai_mode(sleep=time.sleep, clock=time.monotonic):
    """Hugo absent depuis AUTO_AFTER_S : mode IA automatique (le 27B tient en VRAM, job-scout s'en sert) ;
    à son retour tout redevient comme avant, seulement si c'est nous qui l'avions activé."""
    since = None
    while True:
        sleep(30)
        try:
            if _idle():
                since = since or clock()
                if not (RUNTIME / "ai-mode").exists() and clock() - since >= AUTO_AFTER_S:
                    subprocess.run([str(AI_MODE), "on"], env=_env(), timeout=60)
                    AUTO_FLAG.touch()
                    # économiseur relancé en version « mode IA » (OLED seul, décodage logiciel) : VRAM libre
                    subprocess.run([str(OLED), "stop"], env=_env(), timeout=30)
                    subprocess.run([str(OLED), "start"], env=_env(), timeout=30)
                    since = clock()  # si ai-mode a échoué : nouvel essai seulement après un autre délai complet
            else:
                since = None
                if AUTO_FLAG.exists():
                    AUTO_FLAG.unlink()
                    subprocess.Popen([str(AI_MODE), "off"], env=_env(), start_new_session=True)
        except Exception as e:
            print(f"mode IA auto : {e}", flush=True)


def status() -> dict:
    out = {"host": os.uname().nodename, "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
           "uptime_s": int(float(Path("/proc/uptime").read_text().split()[0])),
           "ai_mode": (RUNTIME / "ai-mode").exists() if AI_MODE.exists() else None}
    out["user_idle"] = _idle() if AI_MODE.exists() else None
    out["ai_mode_auto"] = AUTO_FLAG.exists() if AI_MODE.exists() else None
    try:
        q = subprocess.run(["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw",
                            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=5).stdout.split(",")
        out["gpu"] = {"name": q[0].strip(), "util": int(q[1]), "vram_used_mib": int(q[2]), "vram_total_mib": int(q[3]),
                      "temp_c": int(q[4]), "power_w": round(float(q[5]))}
    except Exception:
        out["gpu"] = None
    try:
        out["models"] = [{"id": m["id"], "status": m.get("status", {}).get("value")} for m in _router("/models")["data"]]
    except Exception:
        out["models"] = None  # routeur arrêté
    out["services"] = {name: subprocess.run(["systemctl", *(["--user"] if scope == "user" else []), "is-active", name],
                                            capture_output=True, text=True).stdout.strip() for name, scope in SERVICES}
    return out


class Handler(BaseHTTPRequestHandler):
    def _json(self, code, payload):
        body = json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self) -> bool:
        if self.headers.get("Authorization") == f"Bearer {KEY}":
            return True
        self._json(401, {"error": "clé API requise"})
        return False

    def log_message(self, *args):
        pass

    def do_GET(self):
        if not self._authorized():
            return
        if self.path == "/status":
            return self._json(200, status())
        self._json(404, {"error": "not found"})

    def do_POST(self):
        if not self._authorized():
            return
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
        except json.JSONDecodeError:
            return self._json(400, {"error": "JSON invalide"})
        if self.path == "/ai-mode" and AI_MODE.exists():
            subprocess.Popen([str(AI_MODE), "on" if body.get("on") else "off"], env=_env(),
                             start_new_session=True)
            return self._json(202, {"ok": True})
        if self.path in ("/llm/load", "/llm/unload") and body.get("model"):
            try:
                return self._json(200, _router("/models/" + self.path.rsplit("/", 1)[1], {"model": body["model"]}))
            except Exception as e:
                return self._json(502, {"error": str(e)})
        self._json(404, {"error": "not found"})


if __name__ == "__main__":
    if AI_MODE.exists() and os.environ.get("AI_STATUS_AUTO", "1") != "0":
        threading.Thread(target=auto_ai_mode, daemon=True).start()
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
