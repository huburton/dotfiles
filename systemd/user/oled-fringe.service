[Unit]
Description=Correction des franges QD-OLED de l'écran AOC (shader Hyprland)
# Pas d'écran QD-OLED sur le portable : le service ne fait alors rien (il attend).
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/bin/oled-fringe daemon
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
